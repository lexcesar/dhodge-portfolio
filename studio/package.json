{
	"name": "dhodge-studio",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "sanity dev",
		"build": "sanity build",
		"deploy": "sanity deploy",
		"typecheck": "tsc --noEmit",
		"schema:extract": "sanity schema extract --enforce-required-fields --force",
		"import:dry": "sanity exec scripts/import.ts --with-user-token -- --dry",
		"import": "sanity exec scripts/import.ts --with-user-token",
		"build:preview": "esbuild preview/preview.ts --bundle --format=esm --minify --target=es2022 --legal-comments=none --outfile=../design/assets/preview.js && cp node_modules/@sanity/visual-editing-standalone/dist/styles.css ../design/assets/preview.css"
	},
	"dependencies": {
		"@sanity/icons": "^5.4.0",
		"@sanity/locale-pt-br": "^1.1.37",
		"@sanity/orderable-document-list": "^2.0.30",
		"@sanity/vision": "^6.21.0",
		"react": "^19.2.0",
		"react-dom": "^19.2.0",
		"sanity": "^6.25.0",
		"styled-components": "^6.1.15"
	},
	"devDependencies": {
		"@sanity/client": "^8.17.0",
		"@sanity/core-loader": "^2.3.0",
		"@sanity/visual-editing-standalone": "^2.0.4",
		"@types/node": "^24.19.4",
		"@types/react": "^19.2.0",
		"esbuild": "^0.28.2",
		"typescript": "^5.9.0"
	}
}
